rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function role() {
      return signedIn() ? userDoc(request.auth.uid).data.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isParent() {
      return role() == 'parent';
    }

    function isTeacher() {
      return role() == 'teacher';
    }

    function assignedSection() {
      return userDoc(request.auth.uid).data.assignedSection;
    }

    match /users/{userId} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    match /children/{childId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.parentId == request.auth.uid ||
        (isTeacher() &&
          resource.data.status == 'approved' &&
          resource.data.section == assignedSection())
      );

      allow create: if isParent() &&
        request.resource.data.parentId == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update, delete: if isAdmin() ||
        (isParent() &&
          resource.data.parentId == request.auth.uid &&
          request.resource.data.parentId == request.auth.uid &&
          request.resource.data.status == resource.data.status);
    }

    match /guardians/{guardianId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.parentId == request.auth.uid ||
        (isTeacher() && resource.data.active == true)
      );

      allow create: if isParent() &&
        request.resource.data.parentId == request.auth.uid &&
        request.resource.data.active == true;

      allow update: if signedIn() && (
        isAdmin() ||
        (isParent() &&
          resource.data.parentId == request.auth.uid &&
          request.resource.data.parentId == request.auth.uid &&
          resource.data.revokedByAdmin != true &&
          request.resource.data.revokedByAdmin == resource.data.revokedByAdmin)
      );

      allow delete: if isAdmin();
    }

    match /sections/{sectionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /pickupRequests/{requestId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.parentId == request.auth.uid ||
        (isTeacher() && resource.data.section == assignedSection())
      );

      allow create: if isParent() &&
        request.resource.data.parentId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        get(/databases/$(database)/documents/children/$(request.resource.data.childId)).data.parentId == request.auth.uid &&
        get(/databases/$(database)/documents/children/$(request.resource.data.childId)).data.status == 'approved' &&
        request.resource.data.section == get(/databases/$(database)/documents/children/$(request.resource.data.childId)).data.section;

      allow update: if isAdmin() ||
        (isTeacher() &&
          resource.data.section == assignedSection() &&
          request.resource.data.section == resource.data.section) ||
        (isParent() &&
          resource.data.parentId == request.auth.uid &&
          request.resource.data.parentId == request.auth.uid &&
          (resource.data.status == 'pending' || resource.data.status == 'acknowledged') &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'cancelledAt',
            'cancelledBy',
            'updatedAt'
          ]));

      allow delete: if isAdmin();
    }

    match /pickupLogs/{logId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.parentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        (isTeacher() && resource.data.section == assignedSection())
      );

      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    match /pickupStatus/{statusId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.parentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        (isTeacher() && resource.data.section == assignedSection())
      );

      allow create, update: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;

      allow delete: if isAdmin();
    }

    match /qrUses/{qrUseId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.usedByTeacherId == request.auth.uid
      );

      allow create: if isTeacher() &&
        request.resource.data.usedByTeacherId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
